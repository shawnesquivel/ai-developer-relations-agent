# Daytona
DAYTONA_API_KEY=
DAYTONA_TARGET=us

# Neo4j local or Aura
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Nosana OpenAI-compatible vLLM endpoint (unused while OPENAI_API_KEY is set)
NOSANA_ENDPOINT=
NOSANA_API_KEY=
NOSANA_MODEL=DeepSeek-R1-Distill-Qwen-1.5B

# OpenAI — preferred when OPENAI_API_KEY is set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Composio / GitHub demo
COMPOSIO_API_KEY=
GITHUB_PAT=
COMPOSIO_USER_ID=hacksprint-demo

# Optional local override for the authenticated Composio relay used by Daytona
DENNIS_PUBLIC_URL=https://dennis-dusky.vercel.app
